import Foundation

public enum EDGameMessageType: Int, Hashable, Codable, Sendable, Equatable {
    case info, warning, success, other
}

public struct EDGameMessage: Sendable, Equatable {
    public let id: UUID = UUID()
    public let type: EDGameMessageType
    public let message: String
    public let timestamp: Date

    public init(type: EDGameMessageType, message: String, timestamp: Date = Date()) {
        self.type = type
        self.message = message
        self.timestamp = timestamp
    }
}